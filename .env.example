# Avito Kitchen
POSTGRES_HOST_PORT=5433
AVITO_KITCHEN_HTTP_ADDR=:8080
AVITO_KITCHEN_DATABASE_URL=postgres://avito:avito@postgres:5432/avito_kitchen?sslmode=disable
AVITO_KITCHEN_DATABASE_CONNECT_TIMEOUT=5s
AVITO_KITCHEN_DATABASE_PING_TIMEOUT=3s
AVITO_KITCHEN_READINESS_TIMEOUT=2s
AVITO_KITCHEN_SHUTDOWN_TIMEOUT=10s
AVITO_KITCHEN_ORDER_PROCESSOR_INTERVAL=1s
AVITO_KITCHEN_CAFE_REQUEST_TIMEOUT=3s

# Demo Cafe
DEMO_CAFE_HTTP_ADDR=:8081
DEMO_CAFE_SHUTDOWN_TIMEOUT=10s
